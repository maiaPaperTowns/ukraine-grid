# Copy to .env and adjust as needed. docker-compose.yml sets sane defaults for
# local dev directly; this file matters most for running apps/api standalone
# (outside compose) and for documenting what the Railway deploy needs.

# --- apps/api ---
DATABASE_URL=postgresql+psycopg://ukrainegrid:ukrainegrid@localhost:5432/ukrainegrid
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Simulated outage engine - see apps/api/app/services/outage_simulator.py.
# There is no real public live-outage feed for Ukraine; this is an honest,
# clearly-labeled simulation.
OUTAGE_TICK_SECONDS=20
OUTAGE_EDGE_BLOCK_RATIO=0.12
OUTAGE_FACILITY_UNPOWERED_RATIO=0.2
OUTAGE_MAX_CHANGES_PER_TICK=3
OUTAGE_RANDOM_SEED=
OUTAGE_SIMULATION_ENABLED=true

# --- apps/web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
